{
  "manifest_version": 3,
  "name": "Anywhere",
  "version": "0.1.0",
  "description": "Apple's continuity, for everything everywhere — cross-platform copy/paste.",
  "permissions": ["clipboardRead", "clipboardWrite", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "anywhere@anywhere.app"
    }
  }
}